rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // قواعد السماح للمستخدمين المسجلين برفع وقراءة الصور والفيديوهات والتسجيلات الصوتية في المحادثات
    match /chats/{chatId}/{folder}/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // قاعدة عامة لكافة الملفات
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
